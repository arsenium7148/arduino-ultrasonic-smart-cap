
const int trigPin = 9;
const int echoPin = 10;
const int buzzerPin = 6;

const int threshold = 70;

int readDistance() {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(3);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  unsigned long duration = pulseIn(echoPin, HIGH, 30000);

  if (duration == 0) return -1;

  int cm = duration * 0.0343 / 2;

  if (cm < 2 || cm > 400) return -1;

  return cm;
}

void setup() {
  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);
  pinMode(buzzerPin, OUTPUT);

  Serial.begin(9600);
}

void loop() {
  long sum = 0;
  int count = 0;

  for (int i = 0; i < 5; i++) {
    int d = readDistance();

    if (d > 0) {
      sum += d;
      count++;
    }

    delay(25);
  }

  if (count < 3) {
    noTone(buzzerPin);
    return;
  }

  int distance = sum / count;

  Serial.print("Distance: ");
  Serial.print(distance);
  Serial.println(" cm");

  if (distance > threshold) {
    noTone(buzzerPin);
    delay(50);
    return;
  }

  if (distance <= 10) {
    tone(buzzerPin, 3000); 
    delay(100);
    return;
  }

  int frequency;
  int pauseTime;

  if (distance <= 20) {
    frequency = 2800;
    pauseTime = 30;
  } else if (distance <= 40) {
    frequency = 2400;
    pauseTime = 100;
  } else {
    frequency = 1800;
    pauseTime = 350;
  }

  tone(buzzerPin, frequency);
  delay(100);
  noTone(buzzerPin);
  delay(pauseTime);
}
